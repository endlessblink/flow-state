[Unit]
Description=FlowState always-on desktop process
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=simple
Environment=HOME=%h
Environment=XDG_CONFIG_HOME=%h/.config
Environment=FLOWSTATE_SUPERVISED=1
Environment=FLOWSTATE_UPDATE_EXIT_CODE=75
# Keep the supervised renderer visible on login. The background flag creates a
# 10x10 hidden window under KDE, so the user sees a running process but no app.
ExecStart=%h/.local/bin/FlowState-launch.sh --user-data-dir=%h/.config/flow-state
Restart=always
RestartPreventExitStatus=75
RestartSec=5s
TimeoutStopSec=20s

[Install]
WantedBy=graphical-session.target
